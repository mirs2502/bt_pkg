<root main_tree_to_execute="MotorSpinTree">
    <TreeNodesModel>
        <Action ID="ControlMotor">
            <input_port name="node"/>
            <input_port name="motor_id"/>
            <input_port name="pwm_value"/>
        </Action>
        <Action ID="Wait">
            <input_port name="wait_duration"/>
        </Action>
    </TreeNodesModel>

    <BehaviorTree ID="MotorSpinTree">
        <KeepRunningUntilFailure>
            <Sequence>
                <!-- Motor ID 2 corresponds to Pin 22(DIR)/23(PWM) and 15/16 -->
                <!-- PWM value can be edited in Groot -->
                <ControlMotor node="{node}" motor_id="2" pwm_value="80"/>
                <!-- Wait 0.5s and repeat (Heartbeat) -->
                <Wait wait_duration="0.5"/>
            </Sequence>
        </KeepRunningUntilFailure>
    </BehaviorTree>
</root>
