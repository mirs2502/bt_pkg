<root main_tree_to_execute="MotorDualSpinTree">
    <TreeNodesModel>
        <Action ID="ControlMotor">
            <input_port name="node"/>
            <input_port name="motor_id"/>
            <input_port name="pwm_value"/>
        </Action>
        <Action ID="Wait">
            <input_port name="wait_duration"/>
        </Action>
    </TreeNodesModel>

    <BehaviorTree ID="MotorDualSpinTree">
        <KeepRunningUntilFailure>
            <Sequence>
                <!-- Motor ID 1 -->
                <ControlMotor node="{node}" motor_id="1" pwm_value="190"/>
                <!-- Motor ID 2 -->
                <ControlMotor node="{node}" motor_id="2" pwm_value="100"/>
                <!-- Wait 0.5s and repeat (Heartbeat) -->
                <Wait wait_duration="0.5"/>
            </Sequence>
        </KeepRunningUntilFailure>
    </BehaviorTree>
</root>
