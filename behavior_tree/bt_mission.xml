<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
    <!-- ////////// -->
    <BehaviorTree ID="MainTree">
        <Sequence name="FullMission">
            <Sequence name="SetupSequence">
                <Sequence name="GatherInformation">
                    <RetryUntilSuccessful num_attempts="20">
                        <Fallback>
                            <CheckConeCount target_count="4"/>
                            <Sequence>
                                <Action ID="DriveRobot" node="{node}" linear_x="0.0" angular_z="0.5" duration="2.1"/>
                                <Action ID="Wait" wait_duration="1.0"/>
                                <AlwaysFailure/>
                            </Sequence>
                        </Fallback>
                    </RetryUntilSuccessful>
                    <Action ID="Wait" wait_duration="1.0"/>
                </Sequence>
                <RetryUntilSuccessful num_attempts="3">
                    <Fallback name="ScanFallback">
                        <Action ID="ScanAndCreatePolygon" area_polygon="{area_polygon}" node="{node}"/>
                        <Sequence>
                            <Action ID="Wait" wait_duration="1.0"/>
                            <AlwaysFailure/>
                        </Sequence>
                    </Fallback>
                </RetryUntilSuccessful>
                <Action ID="GenerateCoveragePath" area_polygon="{area_polygon}" coverage_path="{coverage_path}" node="{node}" start_pose="{start_pose}"/>
                <Action ID="Wait" wait_duration="2.0"/>
            </Sequence>
            <Fallback name="MissionFallback">
                <Sequence name="ExecutionSequence">
                    <Fallback name="MoveToStartFallback">
                        <Action ID="NavigateToPose" goal="{start_pose}"/>
                        <Sequence name="RetryStart">
                            <Action ID="Wait" wait_duration="1.0"/>
                            <Action ID="LocalizeWithCones" node="{node}"/>
                            <Action ID="NavigateToPose" goal="{start_pose}"/>
                        </Sequence>
                    </Fallback>

                    <Fallback name="CoverageFallback">
                        <!-- 通常の経路追従（散水継続） -->
                        <Parallel success_threshold="1" failure_threshold="1">
                            <!-- 散水継続ループ（ハートビート） -->
                            <KeepRunningUntilFailure>
                                <Sequence>
                                    <Action ID="ControlMotor" node="{node}" motor_id="1" pwm_value="190"/>
                                    <Action ID="ControlMotor" node="{node}" motor_id="2" pwm_value="100"/>
                                    <Action ID="Wait" wait_duration="0.5"/>
                                </Sequence>
                            </KeepRunningUntilFailure>
                            <!-- 経路追従 -->
                            <Action ID="FollowPath" controller_id="CoverageController" path="{coverage_path}"/>
                        </Parallel>

                        <!-- Recovery（散水なし） -->
                        <Sequence name="RecoveryRoutine">
                            <Action ID="Wait" wait_duration="2.0"/>
                            <Action ID="DriveRobot" node="{node}" linear_x="0.0" angular_z="0.5" duration="6.3"/>
                            <Action ID="LocalizeWithCones" node="{node}"/>

                            <!-- Recovery後、再び散水ありの経路追従 -->
                            <Parallel success_threshold="2" failure_threshold="2">
                                <KeepRunningUntilFailure>
                                    <Sequence>
                                        <Action ID="ControlMotor" node="{node}" motor_id="1" pwm_value="190"/>
                                        <Action ID="ControlMotor" node="{node}" motor_id="2" pwm_value="100"/>
                                        <Action ID="Wait" wait_duration="0.5"/>
                                    </Sequence>
                                </KeepRunningUntilFailure>
                                <Action ID="FollowPath" controller_id="CoverageController" path="{coverage_path}"/>
                            </Parallel>
                        </Sequence>
                    </Fallback>

                    <!-- ミッション完了時に散水停止 -->
                    <Action ID="ControlMotor" node="{node}" motor_id="1" pwm_value="0"/>
                    <Action ID="ControlMotor" node="{node}" motor_id="2" pwm_value="0"/>

                    <!-- Mission Complete: Wait indefinitely to prevent restart -->
                    <Wait wait_duration="99999.0"/>
                </Sequence>
                <Sequence name="FailureHandler">
                     <Wait wait_duration="99999.0"/>
                </Sequence>
            </Fallback>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="ControlMotor">
            <input_port name="motor_id"/>
            <input_port name="node"/>
            <input_port name="pwm_value"/>
        </Action>
        <Action ID="DriveRobot">
            <input_port name="angular_z"/>
            <input_port name="duration"/>
            <input_port name="linear_x"/>
            <input_port name="node"/>
        </Action>
        <Action ID="FollowPath">
            <input_port name="controller_id"/>
            <input_port name="path"/>
        </Action>
        <Action ID="GenerateCoveragePath">
            <input_port name="area_polygon"/>
            <output_port name="coverage_path"/>
            <input_port name="node"/>
            <output_port name="start_pose"/>
        </Action>
        <Action ID="LocalizeWithCones">
            <input_port name="node"/>
        </Action>
        <Action ID="NavigateThroughPoses">
            <input_port name="goals"/>
        </Action>
        <Action ID="NavigateToPose">
            <input_port name="goal"/>
        </Action>
        <Action ID="ScanAndCreatePolygon">
            <output_port name="area_polygon"/>
            <input_port name="node"/>
        </Action>
        <Action ID="Spin">
            <input_port name="spin_dist"/>
        </Action>
        <Action ID="Wait">
            <input_port name="wait_duration"/>
        </Action>
        <Condition ID="CheckConeCount">
            <input_port name="target_count"/>
        </Condition>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
